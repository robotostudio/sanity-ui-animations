# Root env for repo-level scripts (copy to .env.local, which is gitignored).
# Used by `pnpm tokens:sync` to write the `designTokens` singleton.
SANITY_UI_ANIMATIONS_PROJECT_ID=
SANITY_UI_ANIMATIONS_DATASET=development
# Editor/write token. Never commit the real value.
SANITY_UI_ANIMATIONS_WRITE_TOKEN=
