{
  "name": "sanity-ui-animations",
  "version": "1.0.0",
  "private": true,
  "description": "Prompt-to-UI-animation for Sanity Studio: editors describe a product flow, Sanity Agent Actions generate a structured scene spec, and a trusted primitive library renders it on-brand in the Studio and on a Next.js site.",
  "keywords": [
    "sanity",
    "agent-actions",
    "ui-animations",
    "scenes",
    "nextjs",
    "turborepo",
    "monorepo",
    "typescript"
  ],
  "license": "MIT",
  "author": "Roboto Studio (https://robotostudio.com)",
  "homepage": "https://github.com/robotostudio/sanity-ui-animations#readme",
  "bugs": {
    "url": "https://github.com/robotostudio/sanity-ui-animations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robotostudio/sanity-ui-animations.git"
  },
  "scripts": {
    "build": "turbo run build",
    "build:studio": "turbo run build --filter=studio",
    "build:web": "turbo run build --filter=web",
    "dev": "turbo run dev",
    "dev:studio": "turbo run dev --filter=studio",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types",
    "type": "turbo run type",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "tokens:sync": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/tokens-sync.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@sanity-ui-animations/logger": "workspace:*",
    "@sanity-ui-animations/typescript-config": "workspace:*",
    "@sanity-ui-animations/ui-animations": "workspace:*",
    "@sanity/client": "catalog:",
    "turbo": "^2.11.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  }
}
