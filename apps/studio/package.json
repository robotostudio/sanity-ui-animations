{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "MIT",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "deploy-graphql": "sanity graphql deploy",
    "extract": "sanity schema extract --force",
    "check-types": "tsc --noEmit",
    "type": "sanity typegen generate && biome format --write ../../packages/sanity/src/sanity.types.ts",
    "sync-thumbnails": "node --experimental-strip-types ../../packages/sanity-blocks/scripts/sync-thumbnails.ts --target-root ../../apps/studio/static/thumbnails --file-prefix preview-",
    "postinstall": "sanity exec scripts/cli-alert-for-data.ts && pnpm sync-thumbnails",
    "test": "vitest run",
    "harness": "vite --config harness/vite.config.mts"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@robotostudio/sanity-plugin-lucide-icon-picker": "^1.0.2",
    "@sanity-ui-animations/env": "workspace:*",
    "@sanity-ui-animations/logger": "workspace:*",
    "@sanity-ui-animations/sanity-blocks": "workspace:*",
    "@sanity-ui-animations/ui-animations": "workspace:*",
    "@sanity/assist": "^6.2.1",
    "@sanity/client": "catalog:",
    "@sanity/functions": "^1.8.0",
    "@sanity/icons": "^5.2.1",
    "@sanity/orderable-document-list": "^2.0.24",
    "@sanity/ui": "^4.0.6",
    "@sanity/vision": "^6.16.0",
    "dotenv": "^17.4.2",
    "friendlier-words": "^1.2.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-is": "catalog:",
    "sanity": "catalog:",
    "sanity-plugin-asset-source-unsplash": "^7.0.25",
    "sanity-plugin-media": "^6.3.1",
    "sanity-plugin-mux-input": "^5.0.12",
    "slugify": "^1.6.9",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.24.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "catalog:",
    "vite": "^8.3.1",
    "vitest": "catalog:"
  }
}
